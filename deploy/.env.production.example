# 复制为 deploy/.env.production 后填写；该实例文件已被 Git 忽略。
COMPOSE_PROJECT_NAME=yuking-restaurant-saas
TZ=Asia/Shanghai

PUBLIC_DOMAIN=api.example.com
TLS_EMAIL=
NGINX_TEMPLATE=api-http.conf.template
BACKEND_IMAGE=yuking/restaurant-saas:1.6.0
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"
MERCHANT_WEBSOCKET_ALLOWED_ORIGINS=https://admin.example.com

DB_NAME=siam_db
DB_APP_USER=siam_app
DB_ROOT_PASSWORD=
DB_PASSWORD=

REDIS_PASSWORD=

MONGO_ROOT_USERNAME=siam_root
MONGO_ROOT_PASSWORD=
MONGO_APP_DATABASE=siam_db
MONGO_APP_USER=siam_app
MONGO_APP_PASSWORD=
MONGODB_URI=

PAYMENT_CONFIG_MASTER_KEY=
WECHAT_PAY_NOTIFY_BASE_URL=https://api.example.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
BAIDU_MAP_AK=
XINYEYUN_USER=
XINYEYUN_KEY=
