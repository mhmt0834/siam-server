log_format safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# Nginx is the public edge on this deployment, so $remote_addr is authoritative.
# Do not enable real_ip_header unless every set_real_ip_from CIDR is explicitly trusted.
map $http_token $authenticated_rate_key {
    "~^[A-Za-z0-9._-]{16,128}$" $http_token;
    default $binary_remote_addr;
}

map $uri $login_rate_key {
    default "";
    "~^/(siam-server/)?rest/(admin|member|merchant)/(login|loginByMobile|verification/login|weChat/login|weChat/silence/login)$" $binary_remote_addr;
}

map $uri $order_submit_rate_key {
    default "";
    "~^/(siam-server/)?rest/member/order/insert$" $authenticated_rate_key;
}

map $uri $payment_rate_key {
    default "";
    "~^/(siam-server/)?rest/member/wxPay/toPay4Applet$" $authenticated_rate_key;
}

map $uri $merchant_write_rate_key {
    default "";
    "~^/(siam-server/)?rest/merchant/order/(accept|complete|updateStatus)$" $authenticated_rate_key;
}

# IP is only the broad abuse circuit breaker. Authenticated sensitive writes use token-bound keys.
limit_req_zone $binary_remote_addr zone=edge_ip_limit:10m rate=120r/s;
limit_req_zone $login_rate_key zone=login_limit:10m rate=6r/m;
limit_req_zone $order_submit_rate_key zone=order_submit_limit:10m rate=6r/m;
limit_req_zone $payment_rate_key zone=payment_limit:10m rate=10r/m;
limit_req_zone $merchant_write_rate_key zone=merchant_write_limit:10m rate=30r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream restaurant_backend {
    server ${BACKEND_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    server_name ${PUBLIC_DOMAIN};

    access_log /var/log/nginx/access.log safe;
    error_log /var/log/nginx/error.log warn;
    client_max_body_size 10m;
    limit_req_status 429;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /healthz {
        access_log off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://restaurant_backend/siam-server/actuator/health;
    }

    location = /rest/merchant/order/realtime {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_pass http://restaurant_backend/siam-server/rest/merchant/order/realtime;
    }

    location = /siam-server/rest/merchant/order/realtime {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_pass http://restaurant_backend;
    }

    location /rest/ {
        limit_req zone=edge_ip_limit burst=240 nodelay;
        limit_req zone=login_limit burst=6 nodelay;
        limit_req zone=order_submit_limit burst=3 nodelay;
        limit_req zone=payment_limit burst=5 nodelay;
        limit_req zone=merchant_write_limit burst=10 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://restaurant_backend/siam-server/rest/;
    }

    location /siam-server/rest/ {
        limit_req zone=edge_ip_limit burst=240 nodelay;
        limit_req zone=login_limit burst=6 nodelay;
        limit_req zone=order_submit_limit burst=3 nodelay;
        limit_req zone=payment_limit burst=5 nodelay;
        limit_req zone=merchant_write_limit burst=10 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://restaurant_backend;
    }

    location / {
        return 404;
    }
}
