[Unit]
Description=Restaurant SaaS daily data backup
Requires=docker.service
After=docker.service
ConditionPathExists=__DEPLOY_ROOT__/docker/.env.production

[Service]
Type=oneshot
Environment=ENV_FILE=__DEPLOY_ROOT__/docker/.env.production
ExecStart=__DEPLOY_ROOT__/docker/scripts/backup.sh
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
